  "why": "v1 scored a Preset 2 round whose deflate valve never throttled in the 200-245 mmHg window (-15.49 mmHg/s against a healthy -1.56..-1.91). The capture decoded, the fault counters were clean and the closeout confirmed, so no v1 rule applied, and the frozen transient rule missed it because the failed valve raised the whole surrounding envelope (neighbourhood median 19.93 mV, ratio 1.90 against a 2.0 threshold). The lesson is that capture validity and waveform interpretation are different questions and need separate gates.",
  "estimator": {
    "path": "tools/reference_bp.py",
    "sha256": "ddc9daf72a55ed5d32d9b8c832e61e76fc04011a8e462aa9be74a877a2ba8868",
    "bytes": 17301,
    "constants": {
      "DEFAULT_SBP_RATIO": "0.5",
      "DEFAULT_DBP_RATIO": "0.6",
      "DEFAULT_SKIP_START_S": "2.0",
      "DEFAULT_MAP_SMOOTHING_S": "2.0",
      "RATIO_SWEEP": "(0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7)",
      "PLATEAU_FRACTION": "0.9",
      "PLATEAU_REFUSE_RATIO": "0.25",
      "MIN_ENVELOPE_V": "0.0001",
      "TRANSIENT_FACTOR": "2.0",
      "SBP_SUSTAINED_SAMPLES": "3",
      "DBP_SUSTAINED_SAMPLES": "3"
    }
  },
  "validity_gate": {
    "path": "tools\\validity_v2.py",
    "sha256": "0857b93a172b027c4ff9c9835b29078cb9c92b848c6b759441d1d1b70bddf880",
    "version": "validity_v2",
    "constants": {
      "PEAK_LOW_MMHG": "200.0",
      "PEAK_HIGH_MMHG": "245.0",
      "DEFLATE_RATE_MAX_MMHG_S": "4.0",
      "MIN_PEAK_WINDOW_POINTS": "40",
      "NORMAL_RATE_OBSERVED": "(1.56, 2.63)",
      "FAILURE_RATE_OBSERVED": "(13.35, 15.49)"
    },
    "criterion": "peak-window (200-245 mmHg) OLS deflation rate; a capture is unusable when |slope| exceeds DEFLATE_RATE_MAX_MMHG_S",
    "rejected_alternative": "a neighbourhood-median ceiling was considered and dropped on measurement: healthy development rounds reach 11.14 mV and healthy prospective rounds reach 10.32 mV, so a 10 mV threshold would refuse valid captures",
    "threshold_provenance": "derived from the development set alone, whose maximum |slope| is 2.63 mmHg/s, so 4.0 sits above anything the fixture produces when it works; the two observed failures were 13.35 and 15.49",
    "scope": "reads only the pressure trace and never the estimator output, so enabling it cannot bias the estimator error statistics",
    "path_note": "moved from tmp\\validity_v2.py because tmp/ is gitignored and a freeze record must ship the code it hashes; file content and sha256 are unchanged"
  },
